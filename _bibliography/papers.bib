@article{karpurapu2026datahugging,
  title={Data-Hugging Shields Proprietary AI Models from Research That Could Disprove Them},
  author={Karpurapu, Anish and Guo, Zhicheng and Hu, Xiao and Rudin, Cynthia},
  journal={npj Artificial Intelligence},
  volume={2},
  number={1},
  pages={45},
  year={2026},
  doi={10.1038/s44387-026-00094-2},
  url={https://www.nature.com/articles/s44387-026-00094-2},
  preview={datahugging.png},
  abstract={“Data hugging” blocks independent verification of medical AI. Apple claims age estimation with a mean absolute error of 2.9 years using photoplethysmographic (PPG) signals. Given PPG’s noise, such accuracy is questionable, raising concerns about other tech companies’ claims. Using UK Biobank data, we find this accuracy unreplicable, achieving results only marginally better than predicting mean age. We advocate for curated public benchmark datasets and evaluation platforms to protect the public from unverifiable claims.}
}

@article{guo2026protocdisco,
  title={ProtoCDisco: Unsupervised Concept Discovery Using Foundation Model Representations},
  author={Guo, Zhicheng and Machado, Maximillian and Donnelly, Jon and Rudin, Cynthia},
  journal={Manuscript in submission},
  year={2026},
  preview={protocdisco.png},
  abstract={Visual concept discovery aims to identify recurring visual patterns in data, providing a structured vocabulary for describing visual content. However, in learned representations, concepts are not explicitly defined: they remain hidden within high-dimensional features, without clear structure. Existing approaches attempt to uncover such concepts through post-hoc discovery methods, supervised prototype-based models, or clustering-based approaches, but typically fail to simultaneously achieve spatial precision, unsupervised discovery, and semantic consistency across images. We propose ProtoCDisco, a lightweight framework that discovers visual concepts from foundation model representations without supervision. Our method learns a set of prototype anchors in a structured feature space, yielding precise concepts that are spatially coherent (consistently localized across images), distinct (minimally overlapping), and complete (preserving the backbone's discriminative power). Across diverse domains and backbones, our concepts match or exceed k-means, MCD, CRAFT and RA-SAE baselines on downstream classification performance, while being significantly more coherent and distinct. We also show in human evaluation that our method receives significantly higher ratings for semantic consistency, spatial specificity, and interpretability, with greater inter-rater agreement than baselines.},
  selected={true}
}

