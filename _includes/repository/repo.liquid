<div class="repo p-2">
  <a class="repo-card" href="https://github.com/{{ include.repository.repository }}">
    <div class="repo-card-title">
      <i class="fa-brands fa-github" aria-hidden="true"></i>
      <span>{{ include.repository.name }}</span>
    </div>
    <p>{{ include.repository.description }}</p>
    <span class="repo-card-link">View on GitHub <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
  </a>
</div>
